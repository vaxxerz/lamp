# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# AI 기여 분석 (/api/ai-report, OpenRouter). 비우면 규칙 분석만 표시
OPENROUTER_API_KEY=
# 선택: OpenRouter 모델 id (기본 anthropic/claude-sonnet-5.5)
OPENROUTER_MODEL=

# 구글 문서 연동 (docs/GOOGLE.md 참고)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# refresh token 암호화 키: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENC_KEY=
# Google Picker (브라우저 노출 OK — API 키는 Picker API + 도메인으로 제한할 것)
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# Google 문서 OAuth용 사이트 주소. Vercel Production에만 해당 배포 주소 설정
# 비우면 요청 origin 사용 (Preview에서 쓸 경우 Google Cloud에도 해당 주소 등록)
NEXT_PUBLIC_SITE_URL=
# /api/google/sync-all 크론 인증
CRON_SECRET=

# 심사용 데모 계정 비밀번호 (npm run seed:demo)
DEMO_PASSWORD=
